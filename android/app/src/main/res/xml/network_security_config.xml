<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only. SPKI pinning is added in Stage 4 in the native network layer. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
